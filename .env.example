# Firebase Web SDK Configuration (Crown of Galar — Auth + Cloud Firestore)
# Copy this file to `.env.local` for local dev OR add these exact keys as
# GitHub Repository Secrets (Settings -> Secrets and variables -> Actions) for GitHub Pages!
# Note: Firebase Web API keys are public client identifiers; security is enforced by `firestore.rules`.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
